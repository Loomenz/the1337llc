---
// Top bar. The links read like a numbered run sheet (01 / 06), so the nav doubles as the page outline.
import { BUSINESS } from '../../data/business';
const links = [
  { n: '01', label: 'Services', href: '/services/' },
  { n: '02', label: 'See it work', href: '/#demo' },
  { n: '03', label: 'Work', href: '/work/' },
  { n: '04', label: 'Pricing', href: '/pricing/' },
  { n: '05', label: 'Crew', href: '/about/' },
  { n: '06', label: 'Contact', href: '/contact/' },
];
const sms = BUSINESS.phone ? `sms:${BUSINESS.phone}` : '/contact/#text';
---
<header class="sticky top-0 z-40 border-b-2 border-ink bg-paper/92 backdrop-blur-[2px]" style="padding-top:env(safe-area-inset-top,0px)">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-[max(16px,env(safe-area-inset-left,0px))] py-3 md:px-8">
    <a href="/" class="group flex items-baseline gap-2" aria-label="1337 home">
      <span class="display text-[2rem] leading-none tracking-tight">1337</span>
      <span class="mono hidden text-[.68rem] uppercase tracking-[.12em] text-mute sm:inline">NWI · CHI</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ol class="flex items-center">
        {links.map((l) => (
          <li class="flex items-center">
            <a href={l.href} class="group flex items-baseline gap-2 px-3 py-2 text-[.95rem] font-medium">
              <span class="mono text-[.68rem] text-mute group-hover:text-ink">{l.n}</span>
              <span class="relative after:absolute after:-bottom-0.5 after:left-0 after:h-[3px] after:w-full after:origin-left after:scale-x-0 after:bg-hivis after:transition-transform after:duration-300 group-hover:after:scale-x-100">{l.label}</span>
            </a>
            {l.n !== '06' && <span aria-hidden="true" class="h-px w-5 bg-ink/30"></span>}
          </li>
        ))}
      </ol>
    </nav>
    <div class="flex items-center gap-2">
    <a href={sms} class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-[.95rem] font-semibold text-paper transition-colors hover:bg-hivis hover:text-ink">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.9A8 8 0 1 1 21 12z"/></svg>
      Text us
    </a>
    <button type="button" class="menu-btn lg:hidden" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="sr-only">Menu</span><span aria-hidden="true" class="bars"><i></i><i></i></span>
    </button>
    </div>
  </div>
  <nav id="menu" class="menu lg:hidden" aria-label="Main" hidden data-menu>
    <ol>
      {links.map((l) => (
        <li><a href={l.href} class="display"><span class="mono">{l.n}</span>{l.label}</a></li>
      ))}
    </ol>
  </nav>
</header>

<style>
  .menu-btn { display: none; }
  @media (max-width: 1023px) { .menu-btn { display: inline-grid; } }
  .menu-btn { place-items: center; width: 46px; height: 46px; border-radius: 999px; border: 2px solid var(--color-ink); cursor: pointer; }
  .bars { display: grid; gap: 6px; width: 18px; }
  .bars i { display: block; height: 2px; background: currentColor; transition: transform .3s var(--ease-snap); }
  .menu-btn[aria-expanded="true"] .bars i:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .bars i:last-child { transform: translateY(-4px) rotate(-45deg); }
  .menu { border-top: 2px solid var(--color-ink); background: var(--color-ink); color: var(--color-paper); max-height: calc(100dvh - 70px); overflow-y: auto; }
  .menu ol { padding: .5rem max(16px, env(safe-area-inset-left, 0px)) 1.5rem; }
  .menu a { display: flex; align-items: baseline; gap: 1rem; font-size: clamp(2.6rem, 13vw, 4.5rem); padding: .55rem 0; border-bottom: 1px solid rgb(242 240 234 / .2); }
  .menu a:hover, .menu a:focus-visible { color: var(--color-hivis); }
  .menu .mono { font-size: .8rem; color: var(--color-hivis); font-weight: 400; }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) li { animation: menuin .45s var(--ease-snap) both; }
    .menu li:nth-child(2) { animation-delay: 40ms; } .menu li:nth-child(3) { animation-delay: 80ms; }
    .menu li:nth-child(4) { animation-delay: 120ms; } .menu li:nth-child(5) { animation-delay: 160ms; } .menu li:nth-child(6) { animation-delay: 200ms; }
    @keyframes menuin { from { opacity: 0; transform: translateY(16px); } }
  }
</style>

<script>
  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  }
  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
