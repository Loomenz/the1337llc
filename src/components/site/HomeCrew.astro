---
// Who we are in three blunt lines, plus the way in to /about/.
const lines: [string, string][] = [
  ['We pick up when you call.', 'Or text back the same day.'],
  ['You own your site.', 'No hostage situations.'],
  ['Plain English.', 'No jargon, no 40-page proposals.'],
];
---
<section class="border-t-2 border-ink" aria-labelledby="crew-title">
  <div class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24">
    <p class="mono mb-5 text-[.75rem] uppercase tracking-[.12em] text-mute">How we work</p>
    <h2 id="crew-title" class="sr-only">How the crew works</h2>
    <ol class="grid gap-2">
      {lines.map(([h, p], i) => (
        <li class="border-b border-ink/20 pb-4">
          <span class="display block text-[clamp(2.6rem,7.4vw,7rem)]">{h}</span><span class="accent block text-[clamp(1.3rem,2.4vw,2rem)] text-mute">{p}</span>
        </li>
      ))}
    </ol>
    <div class="mt-10 flex flex-wrap items-center gap-4 border-t-2 border-ink pt-6">
      <p class="max-w-[44ch] text-[1.15rem]">A small local studio in Northwest Indiana, run by people who own a construction company and other businesses too. We build for owners who'd rather be doing the work than fighting a laptop.</p>
      <a href="/about/" class="ml-auto inline-flex items-center gap-2 rounded-full border-2 border-ink px-6 py-3 font-semibold hover:bg-ink hover:text-paper">About us <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
