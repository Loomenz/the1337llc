---
// Plain questions, plain answers. Native <details>, so it works without JS. Adds FAQPage schema.
interface Props { items: [string, string][]; num?: string; title?: string }
const { items, num = 'FAQ', title = 'Straight answers' } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<section class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24" aria-labelledby="faq-title">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="mono mb-4 text-[.72rem] uppercase tracking-[.12em] text-mute">{num}</p>
      <h2 id="faq-title" class="display mask-lines text-[clamp(2.8rem,6vw,5.4rem)]"><span class="ml"><span>{title}</span></span></h2>
    </div>
    <div class="faq lg:col-span-8">
      {items.map(([q, a]) => (
        <details>
          <summary><span>{q}</span><span aria-hidden="true" class="pm"></span></summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { border-top: 2px solid var(--color-ink); }
  details { border-bottom: 1px solid rgb(17 17 17 / .25); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 1.5rem; align-items: center; padding: 1.25rem 0; cursor: pointer; font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 600; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-mute); }
  .pm { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 99px; border: 2px solid var(--color-ink); transition: background .2s, transform .3s var(--ease-snap); }
  .pm::before, .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; background: currentColor; translate: -50% -50%; }
  .pm::after { rotate: 90deg; transition: rotate .3s var(--ease-snap); }
  details[open] .pm { background: var(--color-hivis); border-color: var(--color-hivis); }
  details[open] .pm::after { rotate: 0deg; }
  details p { padding: 0 3.5rem 1.4rem 0; font-size: 1.12rem; line-height: 1.55; max-width: 62ch; color: var(--color-mute); }
</style>
