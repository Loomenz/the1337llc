---
// Top of every inner page: section number, giant stacked title, one plain line.
// Title lines are HTML strings so a word can be wrapped in <span class="accent"> or <span class="sweep on-load">.
interface Props { num: string; label: string; lines: string[]; lede?: string; dark?: boolean }
const { num, label, lines, lede, dark = false } = Astro.props;
---
<section class:list={['relative', dark ? 'bg-ink text-paper' : '']}>
  <div class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] pb-12 pt-10 md:px-8 md:pb-16 md:pt-16">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 md:mb-10">
      <p class:list={['mono text-[.72rem] uppercase tracking-[.12em]', dark ? 'text-mute-dark' : 'text-mute']}>{num} · {label}</p>
      <slot name="badges" />
    </div>
    <h1 class="display text-[clamp(3.4rem,11.5vw,11rem)]">
      {lines.map((l, i) => <span class="rise"><span style={`--i:${i}`} set:html={l} /></span>)}
    </h1>
    {lede && <p class="fade-up mt-8 max-w-[44ch] border-t-2 border-current pt-6 text-[1.25rem] leading-snug md:text-[1.4rem]">{lede}</p>}
    <slot />
  </div>
</section>
