---
// "See it work": pick a trade, watch a missed call turn into a booked estimate
// and land in the owner's lead board. Plain DOM + timers, no libraries.
// It auto-plays once when scrolled into view; reduced motion shows the end state at once.
import { DEMO_TRADES } from '../../data/demo';
const first = DEMO_TRADES[0];
const steps = [
  ['Call goes unanswered', "You're on a roof. It rings out."],
  ['Text back in seconds', 'From your own number, in your words.'],
  ['They pick a time', "It's on your calendar. Reminder goes out the day before."],
  ['Lead in your board', 'Name, job, the whole thread. Nothing on a sticky note.'],
];
---
<section id="demo" class="relative border-t-2 border-ink" aria-labelledby="demo-title">
  <div class="mx-auto grid max-w-[1440px] gap-10 px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-8" data-demo data-trades={JSON.stringify(DEMO_TRADES)}>
    <div class="lg:col-span-5">
      <p class="mono mb-6 text-[.72rem] uppercase tracking-[.12em] text-mute">02 / 06 · See it work</p>
      <h2 id="demo-title" class="display mask-lines text-[clamp(3rem,7vw,6.6rem)]">
        <span class="ml"><span>Missed call.</span></span>
        <span class="ml"><span><span class="accent">Booked</span> job.</span></span>
      </h2>
      <p class="mt-6 max-w-[38ch] text-[1.2rem] leading-snug">Pick your trade and watch what happens when you can't pick up. This is the real flow, with a made-up customer.</p>

      <div class="mt-7 flex flex-wrap gap-2" role="group" aria-label="Pick your trade">
        {DEMO_TRADES.map((t, i) => (
          <button type="button" class="chip" data-trade={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>
        ))}
      </div>

      <ol class="steps mt-10" aria-label="What happens">
        {steps.map(([h, p], i) => (
          <li class="step" data-step={i}>
            <span class="mono n">0{i + 1}</span>
            <span><b class="block text-[1.05rem]">{h}</b><span class="text-mute">{p}</span></span>
            <span class="bar" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
    </div>

    <div class="stage lg:col-span-7">
      <!-- the phone -->
      <div class="phone" aria-label="Demo phone">
        <div class="notch" aria-hidden="true"></div>
        <header class="phone-head">
          <span class="mono text-[.62rem] uppercase tracking-[.12em] opacity-60">Messages</span>
          <b data-shop>{first.shop}</b>
        </header>
        <ol class="thread" data-thread role="log" aria-live="polite" aria-label="Demo text thread"></ol>
        <button type="button" class="replay mono" data-replay>↻ Play again</button>
      </div>

      <!-- the owner's lead board -->
      <div class="board" aria-label="Demo lead board">
        <header class="board-head mono">
          <span>Leads · today</span><span class="badge">Demo data</span>
        </header>
        <table class="w-full text-left">
          <thead class="mono"><tr><th scope="col">Who</th><th scope="col">Job</th><th scope="col">Status</th></tr></thead>
          <tbody data-board>
            <tr><td>Chris B.</td><td>Gutter quote</td><td><span class="st">Follow-up 2 of 3</span></td></tr>
            <tr><td>Kim L.</td><td>Siding estimate</td><td><span class="st">Quote sent</span></td></tr>
          </tbody>
        </table>
        <p class="board-foot mono" data-foot>Waiting for the next call…</p>
      </div>
    </div>
  </div>
</section>

<style>
  .chip {
    font-weight: 600; font-size: 1rem; padding: .7rem 1.1rem; border-radius: 999px; border: 2px solid var(--color-ink);
    min-height: 44px; transition: background .2s, color .2s, transform .2s var(--ease-snap); cursor: pointer;
  }
  .chip:hover { transform: translateY(-2px); }
  .chip[aria-pressed="true"] { background: var(--color-ink); color: var(--color-paper); }

  .steps { display: grid; border-top: 2px solid var(--color-ink); }
  .step { position: relative; display: grid; grid-template-columns: 2.4rem 1fr; gap: .5rem; padding: 1rem 0; border-bottom: 1px solid rgb(17 17 17 / .2); opacity: .38; transition: opacity .3s; }
  .step .n { font-size: .75rem; padding-top: .2rem; }
  .step .bar { position: absolute; left: 0; bottom: -1px; height: 3px; width: 100%; background: var(--color-hivis); transform: scaleX(0); transform-origin: left; }
  .step.on, .step.done { opacity: 1; }
  .step.on .n { color: var(--color-hivis); font-weight: 700; }
  .step.on .bar { transform: scaleX(1); transition: transform var(--dur, 2s) linear; }
  .step.done .bar { transform: scaleX(1); background: var(--color-ink); }

  .stage { position: relative; display: grid; gap: 1.25rem; justify-items: center; align-content: start; }
  @media (min-width: 768px) { .stage { grid-template-columns: 330px minmax(0, 1fr); align-items: end; justify-items: stretch; } }

  .phone {
    position: relative; width: min(100%, 330px); height: 600px; border-radius: 44px; background: var(--color-ink);
    padding: 14px; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; box-shadow: 10px 10px 0 var(--color-hivis);
  }
  .phone::before { content: ""; position: absolute; inset: 14px; border-radius: 32px; background: #faf9f5; }
  .phone > :not(.notch) { position: relative; }
  .notch { position: absolute; top: 22px; left: 50%; translate: -50% 0; width: 92px; height: 24px; border-radius: 99px; background: var(--color-ink); z-index: 2; }
  .phone-head { display: grid; justify-items: center; gap: .1rem; padding: 3.2rem 1rem .8rem; border-bottom: 1px solid rgb(17 17 17 / .12); font-size: .95rem; }
  .thread { overflow: hidden; display: flex; flex-direction: column; gap: .5rem; padding: .9rem .9rem .6rem; font-size: .92rem; line-height: 1.3; }
  .replay { justify-self: center; margin: .2rem 0 .8rem; font-size: .75rem; padding: .5rem .9rem; border-radius: 99px; border: 1.5px solid currentColor; min-height: 36px; cursor: pointer; }
  .replay:hover { background: var(--color-ink); color: var(--color-paper); }

  .board {
    width: 100%; max-width: 520px; background: var(--color-paper); border: 2px solid var(--color-ink); border-radius: 14px; overflow: hidden;
  }
  .board-head { display: flex; justify-content: space-between; align-items: center; padding: .8rem 1rem; background: var(--color-ink); color: var(--color-paper); font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; }
  .board table { font-size: .9rem; border-collapse: collapse; }
  .board th { font-size: .64rem; text-transform: uppercase; letter-spacing: .12em; color: var(--color-mute); font-weight: 500; padding: .7rem 1rem .4rem; }
  .board-foot { padding: .7rem 1rem; border-top: 2px solid var(--color-ink); font-size: .72rem; color: var(--color-mute); }
</style>

<style is:global>
  /* thread items are created by the script, so these live outside Astro's scoping */
  [data-thread] > li { max-width: 84%; }
  [data-thread] > :first-child { margin-top: auto; }
  .board td { padding: .7rem 1rem; border-top: 1px solid rgb(17 17 17 / .15); vertical-align: top; }
  .board .st { font-family: var(--font-mono); font-size: .72rem; white-space: nowrap; }
  .board .st.hot { background: var(--color-hivis); color: var(--color-ink); padding: .2em .45em; border-radius: 4px; font-weight: 700; }
  @media (max-width: 420px) { .board th:nth-child(2), .board td:nth-child(2) { display: none; } }
  [data-thread] .b { padding: .55rem .8rem; border-radius: 18px; }
  [data-thread] .in { align-self: flex-start; }
  [data-thread] .in .b { background: #e6e3da; border-bottom-left-radius: 5px; }
  [data-thread] .out { align-self: flex-end; }
  [data-thread] .out .b { background: var(--color-ink); color: var(--color-paper); border-bottom-right-radius: 5px; }
  [data-thread] .sys { align-self: center; max-width: 100%; font-family: var(--font-mono); font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-mute); text-align: center; }
  [data-thread] .call { align-self: stretch; max-width: 100%; display: flex; align-items: center; gap: .7rem; padding: .7rem .8rem; border-radius: 16px; border: 2px solid var(--color-ink); background: #fff; }
  [data-thread] .call .ic { flex: none; width: 2.2rem; height: 2.2rem; border-radius: 99px; display: grid; place-items: center; background: var(--color-ink); color: var(--color-paper); }
  [data-thread] .call.missed .ic { background: var(--color-hivis); color: var(--color-ink); }
  [data-thread] .call small { display: block; font-family: var(--font-mono); font-size: .66rem; color: var(--color-mute); }
  [data-thread] .booked { align-self: stretch; max-width: 100%; padding: .75rem .85rem; border-radius: 14px; background: var(--color-hivis); color: var(--color-ink); }
  [data-thread] .booked b { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: 1.5rem; line-height: .9; display: block; }
  [data-thread] .dots span { display: inline-block; width: 6px; height: 6px; margin: 0 1px; border-radius: 9px; background: var(--color-mute); }
  @media (prefers-reduced-motion: no-preference) {
    [data-thread] > li { animation: pop .35s var(--ease-snap) both; }
    @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(.96); } }
    [data-thread] .call.ringing .ic { animation: ring .5s ease-in-out infinite; }
    @keyframes ring { 25% { transform: rotate(-14deg); } 75% { transform: rotate(14deg); } }
    [data-thread] .dots span { animation: dot 1s infinite; }
    [data-thread] .dots span:nth-child(2) { animation-delay: .15s; }
    [data-thread] .dots span:nth-child(3) { animation-delay: .3s; }
    @keyframes dot { 50% { transform: translateY(-4px); } }
    [data-board] tr.new { animation: slotin .6s var(--ease-snap) both; }
    @keyframes slotin { from { opacity: 0; transform: translateX(-16px); background: var(--color-hivis); } }
  }
</style>

<script>
  interface Trade { id: string; label: string; shop: string; caller: string; ask: string; reply: string; pick: string; job: string; slot: string }

  function initDemo() {
    const root = document.querySelector<HTMLElement>('[data-demo]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const trades: Trade[] = JSON.parse(root.dataset.trades || '[]');
    const thread = root.querySelector<HTMLElement>('[data-thread]')!;
    const board = root.querySelector<HTMLElement>('[data-board]')!;
    const foot = root.querySelector<HTMLElement>('[data-foot]')!;
    const shop = root.querySelector<HTMLElement>('[data-shop]')!;
    const stepEls = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-trade]')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timers: number[] = [];
    let current = trades[0];

    const el = (tag: string, cls: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
    const add = (node: HTMLElement) => { thread.append(node); while (thread.scrollHeight > thread.clientHeight + 2 && thread.children.length > 1) thread.firstElementChild!.remove(); return node; };
    const bubble = (side: 'in' | 'out', text: string) => { const li = el('li', side); li.append(el('div', 'b', text)); return add(li); };
    const sys = (text: string) => add(el('li', 'sys', text));
    const phoneIcon = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>';
    const step = (i: number, dur = 2000) => stepEls.forEach((s, j) => {
      s.classList.toggle('done', j < i);
      s.classList.toggle('on', j === i);
      s.style.setProperty('--dur', `${dur}ms`);
    });

    const play = (t: Trade) => {
      timers.forEach(clearTimeout); timers = [];
      current = t;
      thread.replaceChildren();
      board.querySelector('tr.new')?.remove();
      foot.textContent = 'Waiting for the next call…';
      shop.textContent = t.shop;
      const outText = `Hi, this is ${t.shop.replace(/\.$/, '')}. Sorry we missed you, we're out on a job. What can we help with?`;

      // each beat: [delay ms, action]
      const beats: [number, () => void][] = [
        [0, () => {
          step(0, 1900);
          const li = el('li', 'call ringing');
          li.innerHTML = `<span class="ic">${phoneIcon}</span><span><b></b><small>Incoming call · (219) 555-0148</small></span>`;
          li.querySelector('b')!.textContent = t.caller;
          add(li);
        }],
        [1900, () => {
          const c = thread.querySelector('.call')!;
          c.classList.remove('ringing'); c.classList.add('missed');
          c.querySelector('small')!.textContent = 'Missed call · just now';
        }],
        [2600, () => { step(1, 4600); sys('Auto text · 4 seconds later'); }],
        [3100, () => bubble('out', outText)],
        [4300, () => { const li = el('li', 'in dots'); li.innerHTML = '<div class="b"><span></span><span></span><span></span></div>'; add(li); }],
        [5300, () => { thread.querySelector('.dots')?.remove(); bubble('in', t.ask); }],
        [6400, () => bubble('out', t.reply)],
        [7400, () => { step(2, 1800); bubble('in', t.pick); }],
        [8300, () => {
          const li = el('li', 'booked');
          li.append(el('span', 'mono text-[.64rem] uppercase tracking-[.12em]', 'Estimate booked'), el('b', '', t.slot), el('span', 'text-[.85rem]', 'On your calendar. Reminder text goes out the day before.'));
          add(li);
        }],
        [9200, () => {
          step(3, 1200);
          const tr = el('tr', 'new');
          tr.append(el('td', '', t.caller), el('td', '', t.job));
          const td = el('td'); td.append(el('span', 'st hot', `Booked · ${t.slot}`)); tr.append(td);
          board.prepend(tr);
          foot.textContent = 'Full text thread saved with the lead.';
        }],
        [10600, () => { stepEls.forEach((s) => { s.classList.remove('on'); s.classList.add('done'); }); }],
      ];
      if (still) { beats.forEach(([, fn]) => fn()); thread.querySelector('.dots')?.remove(); stepEls.forEach((s) => s.classList.add('done')); return; }
      beats.forEach(([ms, fn]) => timers.push(window.setTimeout(fn, ms)));
    };

    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
      play(trades.find((t) => t.id === c.dataset.trade)!);
    }));
    root.querySelector('[data-replay]')!.addEventListener('click', () => play(current));

    // first play when the phone scrolls into view
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(current); }
    }, { threshold: 0.45 });
    io.observe(root.querySelector('.phone')!);
  }
  initDemo();
  document.addEventListener('astro:page-load', initDemo);
</script>
