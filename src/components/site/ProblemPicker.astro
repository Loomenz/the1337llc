---
// "What's slowing you down?" picker.
// Desktop: pains on the left (one always active), the matching work order on the right.
// Phones: the work order opens right under the row you tapped.
// One row is open at rest, so the section reads complete before anyone taps.
import { FIXES } from '../../data/fixes';
import { BUSINESS } from '../../data/business';
const sms = BUSINESS.phone ? `sms:${BUSINESS.phone}` : '/contact/#text';
---
<section id="fixes" class="bg-ink text-paper" aria-labelledby="fixes-title">
  <div class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14">
      <h2 id="fixes-title" class="display mask-lines max-w-[13ch] text-[clamp(3rem,8.6vw,9rem)]">
        <span class="ml"><span>What's slowing</span></span>
        <span class="ml"><span>you <span class="accent text-hivis">down?</span></span></span>
      </h2>
      <p class="mono text-[.75rem] uppercase tracking-[.12em] text-mute-dark">Pick one</p>
    </div>

    <div class="picker" data-picker>
      {FIXES.map((f, i) => (
        <>
          <button
            type="button"
            class="row group"
            id={`fx-${f.id}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`wo-${f.id}`}
            style={`--r:${i + 1}`}
          >
            <span class="mono num">0{i + 1}</span>
            <span class="display pain">{f.pain}</span>
            <span aria-hidden="true" class="arrow">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M4 11h14M12 5l6 6-6 6"/></svg>
            </span>
          </button>

          <article class="order" id={`wo-${f.id}`} role="region" aria-labelledby={`fx-${f.id}`} hidden={i !== 0}>
            <header class="order-head mono">
              <span>The fix</span>
              <span>0{i + 1} of 0{FIXES.length}</span>
            </header>
            <p class="accent quote">&ldquo;{f.pain}.&rdquo;</p>
            <h3 class="display fixname">{f.name}</h3>
            <p class="fixtext">{f.fix}</p>
            <dl class="mono specs">
              <div><dt>What it costs</dt><dd>{f.cost}</dd></div>
              <div><dt>How fast</dt><dd>{f.speed}</dd></div>
            </dl>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href={`/contact/?fix=${f.id}`} class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-[1.02rem] font-semibold text-paper transition-colors hover:bg-hivis hover:text-ink">Fix this for me <span aria-hidden="true">→</span></a>
              <a href={sms} class="inline-flex min-h-[44px] items-center font-semibold underline decoration-2 underline-offset-4 hover:decoration-hivis">or text us a question</a>
            </div>
            <span aria-hidden="true" class="stamp display">Signed off</span>
          </article>
        </>
      ))}
    </div>

    <p class="mt-12 flex flex-wrap items-baseline gap-x-4 gap-y-2 text-[1.2rem]">
      <span class="text-mute-dark">Not on the list?</span>
      <a href={sms} class="inline-flex min-h-[44px] items-center underline decoration-hivis decoration-[3px] underline-offset-[6px] hover:text-hivis">Text us what's bugging you.</a>
    </p>
  </div>
</section>

<style>
  .picker { border-bottom: 1px solid rgb(242 240 234 / .22); }
  .row {
    position: relative; display: flex; align-items: center; gap: 1rem; width: 100%; text-align: left;
    padding: 1.05rem .25rem; border-top: 1px solid rgb(242 240 234 / .22); color: #8b877d; cursor: pointer;
    transition: color .25s;
  }
  .row .num { width: 2.2rem; flex: none; font-size: .75rem; }
  .row .pain { flex: 1; font-size: clamp(2rem, 6.2vw, 3.6rem); line-height: .9; transition: transform .35s var(--ease-snap); }
  .row .arrow { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 999px; border: 2px solid currentColor; transition: transform .35s var(--ease-snap), background .25s, color .25s, border-color .25s; }
  .row:hover { color: var(--color-paper); }
  .row:hover .pain { transform: translateX(.35rem); }
  .row[aria-expanded="true"] { color: var(--color-paper); }
  .row[aria-expanded="true"] .arrow { background: var(--color-hivis); border-color: var(--color-hivis); color: var(--color-ink); transform: rotate(90deg); }
  .row[aria-expanded="true"] .num { color: var(--color-hivis); }

  /* the work order: a paper ticket on the dark ground */
  .order {
    position: relative; overflow: hidden; background: var(--color-paper); color: var(--color-ink);
    border-radius: 14px; padding: 1.5rem 1.4rem 1.6rem; margin: .4rem 0 1.4rem;
    display: grid; gap: 1rem; align-content: start;
    background-image: radial-gradient(circle at 1px 1px, rgb(17 17 17 / .12) 1px, transparent 0); background-size: 18px 18px;
  }
  .order[hidden] { display: none; }
  .order-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; padding-bottom: .9rem; border-bottom: 2px solid var(--color-ink); }
  .quote { font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.1; color: var(--color-mute); }
  .fixname { font-size: clamp(2.6rem, 5vw, 4.8rem); }
  .fixtext { font-size: 1.2rem; line-height: 1.45; max-width: 44ch; }
  .specs { display: grid; grid-template-columns: 1fr 1fr; border: 2px solid var(--color-ink); border-radius: 8px; }
  .specs > div { padding: .8rem .9rem; }
  .specs > div + div { border-left: 2px solid var(--color-ink); }
  .specs dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; color: var(--color-mute); margin-bottom: .3rem; }
  .specs dd { font-size: .92rem; line-height: 1.4; }
  .stamp {
    position: absolute; right: 1.1rem; top: 3.6rem; font-size: 1.5rem; color: var(--color-hivis);
    border: 3px solid var(--color-hivis); border-radius: 6px; padding: .1em .35em; transform: rotate(-9deg); opacity: .9; pointer-events: none;
  }

  @media (min-width: 1024px) {
    .picker { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr); column-gap: 3rem; border-bottom: 0; }
    .row { grid-column: 1; grid-row: var(--r); padding: 1.15rem .25rem; }
    .row:nth-last-of-type(1) { border-bottom: 1px solid rgb(242 240 234 / .22); }
    .row .pain { font-size: clamp(2rem, 3.5vw, 3.3rem); }
    .order { grid-column: 2; grid-row: 1 / span 6; margin: 0; padding: 2rem 2.2rem 2.2rem; align-self: start; position: sticky; top: 6rem; }
    .stamp { top: 4.3rem; right: 2rem; }
  }
  @media (max-width: 520px) {
    .specs { grid-template-columns: 1fr; }
    .specs > div + div { border-left: 0; border-top: 2px solid var(--color-ink); }
    .stamp { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .order:not([hidden]) { animation: ticket .45s var(--ease-snap); }
    @keyframes ticket { from { opacity: 0; transform: translateY(10px) rotate(-.6deg); } }
    .order:not([hidden]) .stamp { animation: stamp .5s .25s cubic-bezier(.3,1.6,.5,1) backwards; }
    @keyframes stamp { from { opacity: 0; transform: rotate(-9deg) scale(1.8); } }
  }
</style>

<script>
  function initPicker() {
    const root = document.querySelector<HTMLElement>('[data-picker]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const rows = [...root.querySelectorAll<HTMLButtonElement>('.row')];
    const open = (btn: HTMLButtonElement, focusOrder = false) => {
      rows.forEach((r) => {
        const on = r === btn;
        r.setAttribute('aria-expanded', String(on));
        const panel = document.getElementById(r.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
      });
      // on phones, keep the opened ticket in view
      if (focusOrder && matchMedia('(max-width: 1023px)').matches) btn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    rows.forEach((r, i) => {
      r.addEventListener('click', () => open(r, true));
      r.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k !== 'ArrowDown' && k !== 'ArrowUp') return;
        e.preventDefault();
        const next = rows[(i + (k === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length];
        next.focus();
      });
    });
  }
  initPicker();
  document.addEventListener('astro:page-load', initPicker);
</script>
