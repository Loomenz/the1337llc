<script>
import { scramble } from '../scripts/scramble';
import { heroMark } from '../scripts/hero-mark';

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

// rotating headline phrase — Local SEO & expansion first, plain-English owner outcomes
const words = ['own Google Maps.', 'take over nearby towns.', 'win more jobs.', 'get paid faster.', 'catch every call.', 'kill the paperwork.'];
let wi = 0;
const sw = document.getElementById('swap');
if (sw && !reduce) setInterval(() => { wi = (wi + 1) % words.length; scramble(sw, words[wi]); }, 2800);

// Interactive Hero problem pills -> scroll to #blueprint and activate the matching tab
document.querySelectorAll<HTMLAnchorElement>('[data-jump-bp]').forEach((pill) => {
  pill.addEventListener('click', (e) => {
    const idx = pill.dataset.jumpBp;
    const targetTab = document.querySelector<HTMLButtonElement>(`.bp-tab[data-bp="${idx}"]`);
    const section = document.getElementById('blueprint');
    if (targetTab) targetTab.click();
    if (section) {
      e.preventDefault();
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  });
});

heroMark();
</script>
