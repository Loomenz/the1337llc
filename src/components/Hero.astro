<section class="hero"><canvas id="mark3d" class="mark3d" aria-hidden="true"></canvas><div class="halo" aria-hidden="true"></div>
<div class="wrap hero-grid">
  <div>
    <div class="label mono"><span class="dot"><i></i></span>Local help for Northwest Indiana businesses</div>
    <h1>
      <span class="line"><span>Tell us what's costing you jobs.</span></span>
      <span class="line"><span class="grad swap serif" id="swap">We'll fix it.</span></span>
    </h1>
    <p class="lead">Missed calls, slow quotes, chasing checks, competitors showing up first on Google. I'm Ryan. On a free 30-minute call I'll find where the money is leaking, then fix it for a flat price you see before we start.</p>

    <div class="hero-Menu">
      <div class="hero-menu-label mono">WHAT'S SLOWING YOU DOWN? <span class="dim">(TAP ONE TO SEE THE FIX)</span></div>
      <div class="hero-pills">
        <a href="#blueprint" class="hero-pill" data-jump-bp="1">
          <span class="hp-idx mono">01</span>
          <span><b>"I miss calls on the job."</b><small>Every missed caller gets a text back</small></span>
          <i class="hp-arr">→</i>
        </a>
        <a href="#blueprint" class="hero-pill" data-jump-bp="0">
          <span class="hp-idx mono">02</span>
          <span><b>"Nobody finds me on Google."</b><small>Google profile fixed, reviews coming in</small></span>
          <i class="hp-arr">→</i>
        </a>
        <a href="#blueprint" class="hero-pill" data-jump-bp="2">
          <span class="hp-idx mono">03</span>
          <span><b>"I wait weeks to get paid."</b><small>Text invoices, paid by card on site</small></span>
          <i class="hp-arr">→</i>
        </a>
        <a href="#blueprint" class="hero-pill" data-jump-bp="3">
          <span class="hp-idx mono">04</span>
          <span><b>"Quotes go cold."</b><small>Estimates follow up on their own</small></span>
          <i class="hp-arr">→</i>
        </a>
      </div>
    </div>

    <div class="cta">
      <a class="btn primary magnetic" href="/free-audit/">Book a free 30-minute call <span class="arr">→</span></a>
      <a class="btn magnetic" href="/contact/">Get a flat written quote</a>
    </div>
  </div>
</div>
<div class="wrap hero-foot mono" aria-hidden="true">
  <span>N 41.6° / W 87.3° · Northwest Indiana + Chicagoland</span>
  <span class="hide-sm">Flat written quotes · Half down, half at launch</span>
  <span class="hide-sm">You own everything once it's paid</span>
</div>
</section>

<script>
import { scramble } from '../scripts/scramble';
import { heroMark } from '../scripts/hero-mark';

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

// rotating headline phrase — Local SEO & expansion first, plain-English owner outcomes
const words = ["We'll fix it.", 'Catch every call.', 'Get paid faster.', 'Win more jobs.'];
let wi = 0;
const sw = document.getElementById('swap');
if (sw && !reduce) setInterval(() => { wi = (wi + 1) % words.length; scramble(sw, words[wi]); }, 2800);

// Interactive Hero problem pills -> scroll to #blueprint and activate the matching tab
document.querySelectorAll<HTMLAnchorElement>('[data-jump-bp]').forEach((pill) => {
  pill.addEventListener('click', (e) => {
    const idx = pill.dataset.jumpBp;
    const targetTab = document.querySelector<HTMLButtonElement>(`.bp-tab[data-bp="${idx}"]`);
    const section = document.getElementById('blueprint');
    if (targetTab) targetTab.click();
    if (section) {
      e.preventDefault();
      section.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  });
});

heroMark();
</script>
