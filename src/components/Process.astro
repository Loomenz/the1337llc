<script>
// process rail progress
const steps = document.getElementById('steps')!, rail = steps.querySelector<HTMLElement>('.rail i')!;
addEventListener('scroll', () => {
  const r = steps.getBoundingClientRect(), vh = innerHeight;
  const p = Math.min(Math.max((vh * .6 - r.top) / r.height, 0), 1);
  rail.style.setProperty('--p', p * 100 + '%');
}, { passive: true });
</script>
