<section id="services"><div class="wrap">
  <div class="head reveal"><div><div class="eyebrow">Local expansion &amp; automation</div><h2>Take over nearby towns on Google<br>and <span class="grad">get paid faster.</span></h2></div>
  <p class="sub">Stop settling for just the calls in your own zip code. We engineer your Google Map Pack rankings, build town-by-town expansion pages so you dominate neighboring cities, and automate your missed calls, quotes and payments.</p></div>
  <div class="bento">
    <!-- Tile 1 (w4): Local SEO & Multi-Town Business Expansion Flagship -->
    <div class="tile w4 reveal">
      <span class="live mono"><i></i>#1 growth engine</span>
      <div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
      <h3>Local SEO &amp; Multi-Town Business Expansion</h3>
      <p>The wealthiest subdivisions are often one or two towns over—but Google Maps won't show you there unless your site and profile are engineered for it. We overhaul your Google Business Profile for the Top 3 Map Pack, build dedicated Service + Town pages for every city you want to take over, and text every finished job for a 5-star review.</p>
      <div class="sim-feed mono">
        <div class="sim-head"><span>MULTI-TOWN EXPANSION FOOTPRINT // EXAMPLE ROLLOUT</span><span class="ok">0$/LEAD FEES</span></div>
        <div class="sim-rows">
          <div class="sim-row in"><span><b class="ok">✓ Crown Point + St. John</b> · Top-3 Google Map Pack + Town Pages</span><span class="ok">+18 calls / mo</span></div>
          <div class="sim-row in"><span><b class="ok">✓ Schererville + Dyer + Munster</b> · Dedicated Service-Area Funnels</span><span class="ok">+14 calls / mo</span></div>
          <div class="sim-row in"><span><b class="ok">✓ Valparaiso + Chesterton</b> · 1-Tap 5-Star Review Velocity Active</span><span class="ok">5.0 ★ Rating</span></div>
        </div>
      </div>
    </div>

    <!-- Tile 2 (w2): Interactive Missed-Call & Expansion Revenue Calculator -->
    <div class="tile w2 reveal">
      <div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
      <h3>Missed-Call &amp; Expansion Calculator</h3>
      <p>See what extra calls from nearby towns and saved missed calls add to your bottom line:</p>
      <div class="roi-calc mono">
        <label for="mc">Extra jobs won / wk: <b id="mcv">4</b></label>
        <input id="mc" type="range" min="1" max="20" step="1" value="4">
        <label for="jv">Avg profit per job: <b id="jvv">$450</b></label>
        <input id="jv" type="range" min="100" max="2500" step="50" value="450">
        <div class="roi-out">
          <span class="dim">ADDED REVENUE / MO</span>
          <span class="out" id="roi-val">$3,600</span>
        </div>
      </div>
    </div>

    <!-- Tile 3 (w3): Instant Missed-Call Text-Back -->
    <div class="tile w3 reveal">
      <span class="live mono"><i></i>never miss a job</span>
      <div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
      <h3>Instant Missed-Call Text-Back</h3>
      <p>When you are on a mower, on a roof or with a customer, missed callers usually hang up and call the next guy on Google. Our system texts them back right away in your voice, asks what they need, collects job photos and saves the lead straight to your phone.</p>
      <div class="sim-feed mono" id="sms-sim">
        <div class="sim-head"><span>WHEN YOU MISS A CALL ON THE JOB</span><button type="button" class="sim-btn" id="replay-sms">↻ Replay</button></div>
        <div class="sim-rows">
          <div class="sim-row in"><span><b class="warn">Missed call</b> · (219) 555-0184</span><span class="dim">On a job</span></div>
          <div class="sim-row in" style="transition-delay:.25s"><span><b class="ok">→ Instant text sent</b> · "Hey! On a job right now—how can we help?"</span><span class="dim">Sent right away</span></div>
          <div class="sim-row in" style="transition-delay:.5s"><span><b class="ok">✓ Job saved to phone</b> · Driveway tear-out + 2 photos</span><span class="ok">$2,400 saved</span></div>
        </div>
      </div>
    </div>

    <!-- Tile 4 (w3): Instant Ballpark Price Calculators + High-Converting Site -->
    <div class="tile w3 reveal">
      <div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 6h6M9 10h.01M12 10h.01M15 10h.01M9 14h.01M12 14h.01M15 14h.01M9 18h6"/></svg></div>
      <h3>Online "Ballpark Price" Calculators &amp; Lead Sites</h3>
      <p>Stop driving across two counties just to price jobs for tire-kickers. Customers slide their yard or project size on your site, see an instant ballpark range, and send you their phone number ready to book:</p>
      <div class="mini-calc" style="margin-top:auto;padding-top:18px"><label for="sq" style="width:100%">Property / project size: <span id="sqv">5,000</span> sq ft</label><input id="sq" type="range" min="1000" max="20000" step="500" value="5000"><span class="out" id="qout">$45</span><span style="color:var(--dim)">/ visit ballpark</span></div>
    </div>

    <!-- Tile 5 (w3): Credit Cards, Customer Financing & Text-to-Pay -->
    <div class="tile w3 reveal"><div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg></div>
      <h3>Credit Cards, Customer Financing &amp; Text-to-Pay</h3><p>Send a text invoice from your phone and let customers pay by credit card, debit card, Apple Pay or bank transfer in the driveway—plus offer "Pay Over Time" customer financing on big jobs while you get paid upfront.</p>
    </div>

    <!-- Tile 6 (w3): Automatic Quote Chasers & Past-Customer Blasts -->
    <div class="tile w3 reveal"><div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
      <h3>Automatic Quote Chasers &amp; Past-Customer Blasts</h3><p>Stop doing paperwork at 10 PM. Open estimates follow up automatically until the customer books, and seasonal text blasts wake up your past customers whenever your schedule needs work.</p>
    </div>
  </div>
</div></section>

<script>
// spotlight tiles
document.querySelectorAll<HTMLElement>('.tile').forEach((t) => t.addEventListener('pointermove', (e) => {
  const r = t.getBoundingClientRect();
  t.style.setProperty('--x', e.clientX - r.left + 'px');
  t.style.setProperty('--y', e.clientY - r.top + 'px');
}));

// mini quote calc
const sq = document.getElementById('sq') as HTMLInputElement | null;
const sqv = document.getElementById('sqv');
const qo = document.getElementById('qout');
if (sq && sqv && qo) {
  const q = () => {
    const v = +sq.value;
    sqv.textContent = v.toLocaleString();
    qo.textContent = '$' + Math.max(35, Math.round((25 + v * .004) / 5) * 5);
  };
  sq.addEventListener('input', q);
  q();
}

// Lost-Revenue ROI calculator
const mc = document.getElementById('mc') as HTMLInputElement | null;
const jv = document.getElementById('jv') as HTMLInputElement | null;
const mcv = document.getElementById('mcv');
const jvv = document.getElementById('jvv');
const roiVal = document.getElementById('roi-val');
if (mc && jv && mcv && jvv && roiVal) {
  const updateRoi = () => {
    const calls = +mc.value;
    const ticket = +jv.value;
    mcv.textContent = String(calls);
    jvv.textContent = '$' + ticket.toLocaleString();
    const monthlyRecovered = Math.round(calls * ticket * 0.5 * 4);
    roiVal.textContent = '$' + monthlyRecovered.toLocaleString();
  };
  mc.addEventListener('input', updateRoi);
  jv.addEventListener('input', updateRoi);
  updateRoi();
}

// Replay missed-call simulation
const replayBtn = document.getElementById('replay-sms');
const smsSim = document.getElementById('sms-sim');
if (replayBtn && smsSim) {
  replayBtn.addEventListener('click', () => {
    const rows = smsSim.querySelectorAll<HTMLElement>('.sim-row');
    rows.forEach((r) => r.classList.remove('in'));
    void smsSim.offsetWidth;
    setTimeout(() => rows.forEach((r) => r.classList.add('in')), 60);
  });
}
</script>
