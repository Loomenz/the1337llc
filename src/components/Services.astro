      <div class="mini-calc"><label for="sq" style="width:100%">Lawn size: <span id="sqv">5,000</span> sq ft</label><input id="sq" type="range" min="1000" max="20000" step="500" value="5000"><span class="out" id="qout">$45</span><span style="color:var(--dim)">/ visit</span></div></div>
    <div class="tile reveal"><div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
