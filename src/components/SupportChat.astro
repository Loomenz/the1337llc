---
// Website chat bubble. Talks to /api/support (server/support/server.mjs behind nginx).
---
<div class="chat" id="chat">
  <div class="panel" id="chat-panel" role="dialog" aria-label="Chat with 1337 LLC" hidden>
    <div class="head">
      <div><strong>1337 LLC</strong><span>Automated assistant · <a href="mailto:the1337llc@gmail.com">the1337llc@gmail.com</a> for a person</span></div>
      <button type="button" id="chat-close" aria-label="Close chat">×</button>
    </div>
    <div class="list" id="chat-list" aria-live="polite"></div>
    <form id="chat-form">
      <label for="chat-input" class="sr">Your question</label>
      <input id="chat-input" maxlength="500" autocomplete="off" placeholder="Ask about websites, pricing, SEO…">
      <button type="submit" id="chat-send" aria-label="Send">→</button>
    </form>
  </div>
  <button type="button" class="bubble" id="chat-open" aria-label="Chat with 1337 LLC">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/></svg>
  </button>
</div>

<style>
  .chat{position:fixed;right:18px;bottom:18px;z-index:60;font-family:inherit}
  .bubble{width:56px;height:56px;border-radius:50%;border:1px solid var(--line2);background:var(--bg2);color:var(--g);display:grid;place-items:center;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.45)}
  .bubble:hover{border-color:var(--g)}
  .panel{width:min(360px,calc(100vw - 36px));height:min(520px,calc(100vh - 120px));display:flex;flex-direction:column;margin-bottom:12px;border:1px solid var(--line2);border-radius:var(--r);background:var(--bg2);overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.6)}
  .panel[hidden]{display:none}
  .head{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}
  .head strong{display:block;color:var(--ink);font-size:16px}
  .head span{display:block;color:var(--mute);font-size:12px}
  .head a{color:var(--c)}
  .head button{background:none;border:0;color:var(--mute);font-size:24px;line-height:1;cursor:pointer;padding:4px 8px}
  .list{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;font-size:15px}
  .list :global(p){margin:0;max-width:85%;padding:9px 12px;border-radius:14px;white-space:pre-wrap;line-height:1.45}
  .list :global(.bot){align-self:flex-start;background:var(--card);border:1px solid var(--line);color:var(--ink)}
  .list :global(.me){align-self:flex-end;background:rgba(57,255,136,.12);border:1px solid rgba(57,255,136,.35);color:var(--ink)}
  .list :global(.typing){color:var(--dim);font-family:var(--mono);font-size:13px}
  .list :global(a){color:var(--c);text-decoration:underline}
  form{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line)}
  input{flex:1;min-width:0;background:var(--bg);border:1px solid var(--line2);border-radius:10px;color:var(--ink);padding:10px 12px;font:inherit;font-size:16px}
  input:focus{outline:none;border-color:var(--g)}
  form button{background:var(--g);color:var(--bg);border:0;border-radius:10px;padding:0 14px;font-weight:700;cursor:pointer}
  form button:disabled{opacity:.5;cursor:default}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>

<script>
type Turn = { role: 'user' | 'assistant'; text: string };
const GREETING = 'Hi! Ask me about websites, pricing, Google and local SEO, lead tools or IT.';
const KEY = '1337-chat';

const panel = document.getElementById('chat-panel')!;
const list = document.getElementById('chat-list')!;
const form = document.getElementById('chat-form') as HTMLFormElement;
const input = document.getElementById('chat-input') as HTMLInputElement;
const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
const openBtn = document.getElementById('chat-open')!;

let turns: Turn[] = [];
try { turns = JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch {}
let sending = false;

// Bot replies may contain [label](/page) links; render those as site links, everything else as text.
function addText(p: HTMLElement, text: string) {
  const re = /\[([^\]]+)\]\((\/[^)\s]*)\)/g;
  let at = 0;
  for (const m of text.matchAll(re)) {
    p.append(text.slice(at, m.index));
    const a = document.createElement('a');
    a.href = m[2];
    a.textContent = m[1];
    p.append(a);
    at = (m.index || 0) + m[0].length;
  }
  p.append(text.slice(at));
}

function render() {
  list.replaceChildren();
  for (const t of [{ role: 'assistant', text: GREETING } as Turn, ...turns]) {
    const p = document.createElement('p');
    p.className = t.role === 'user' ? 'me' : 'bot';
    if (t.role === 'user') p.textContent = t.text;
    else addText(p, t.text);
    list.append(p);
  }
  if (sending) {
    const p = document.createElement('p');
    p.className = 'typing';
    p.textContent = 'typing…';
    list.append(p);
  }
  list.scrollTop = list.scrollHeight;
  sendBtn.disabled = sending;
  try { sessionStorage.setItem(KEY, JSON.stringify(turns)); } catch {}
}

openBtn.addEventListener('click', () => {
  panel.hidden = false;
  openBtn.hidden = true;
  render();
  input.focus();
});
document.getElementById('chat-close')!.addEventListener('click', () => {
  panel.hidden = true;
  openBtn.hidden = false;
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = input.value.trim();
  if (!text || sending) return;
  turns.push({ role: 'user', text });
  input.value = '';
  sending = true;
  render();
  let reply = "Sorry, the chat couldn't connect. Email the1337llc@gmail.com.";
  try {
    const res = await fetch('/api/support', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: turns }),
    });
    const data = await res.json().catch(() => ({}));
    reply = data.reply || data.error || reply;
  } catch {}
  turns.push({ role: 'assistant', text: reply });
  sending = false;
  render();
});
</script>
