---
// Every section of the business has its own page; the current one is highlighted.
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/systems/', label: 'Systems' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
];
const here = Astro.url.pathname;
---
<header><div class="wrap"><nav class="nav" id="nav">
  <a class="logo" href="/" aria-label="1337 LLC home"><svg class="mark" viewBox="0 0 55 52" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#ececec"/><stop offset="1" stop-color="#a0a0a0"/></linearGradient></defs><rect x="0" y="44.4" width="10" height="7.4" rx="3.3" fill="url(#lg)"/><rect x="15" y="29.6" width="10" height="22.2" rx="3.3" fill="url(#lg)"/><rect x="30" y="29.6" width="10" height="22.2" rx="3.3" fill="url(#lg)"/><rect x="45" y="0" width="10" height="51.8" rx="3.3" fill="url(#lg)"/></svg><span class="lt" data-scramble>1337</span><span class="llc">LLC</span></a>
  <div class="links">{links.map((l) => <a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}</div>
  <div class="nav-end">
    <a class="btn primary magnetic" href="/contact/">Start a project <span class="arr">→</span></a>
    <button class="menu-btn" id="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav"><i></i><i></i></button>
  </div>
</nav></div></header>

<script>
// phone menu: the page links drop down under the nav bar
const nav = document.getElementById('nav')!, btn = document.getElementById('menu-btn')!;
btn.addEventListener('click', () => btn.setAttribute('aria-expanded', String(nav.classList.toggle('open'))));
</script>
