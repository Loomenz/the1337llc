---
// Links point at sections of the home page, so they work from any page.
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/systems/', label: 'Systems' },
  { href: '/#process', label: 'Process' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/blog/', label: 'Blog' },
];
---
<header><div class="wrap"><nav class="nav" id="nav">
  <a class="logo" href="/#top" aria-label="1337 LLC home"><svg class="mark" viewBox="0 0 55 52" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#39ff88"/><stop offset="1" stop-color="#22d3ee"/></linearGradient></defs><rect x="0" y="44.4" width="10" height="7.4" rx="3.3" fill="url(#lg)"/><rect x="15" y="29.6" width="10" height="22.2" rx="3.3" fill="url(#lg)"/><rect x="30" y="29.6" width="10" height="22.2" rx="3.3" fill="url(#lg)"/><rect x="45" y="0" width="10" height="51.8" rx="3.3" fill="url(#lg)"/></svg><span class="lt" data-scramble>1337</span><span class="llc">LLC</span></a>
  <div class="links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
  <a class="btn primary magnetic" href="/#contact">Start a project <span class="arr">→</span></a>
</nav></div></header>
