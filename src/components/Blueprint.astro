<section id="blueprint"><div class="wrap">
  <div class="head reveal">
    <div>
      <div class="eyebrow">Where are you losing jobs or money?</div>
      <h2>Expand into nearby towns.<br><span class="grad">Fix what slows you down.</span></h2>
    </div>
    <p class="sub">Click any growth bottleneck below to see why most local businesses stay stuck in one zip code—and the exact engine we build to expand your reach and automate your day.</p>
  </div>

  <div class="bp-console reveal">
    <div class="bp-tabs mono" role="tablist" aria-label="Business bottlenecks">
      <button type="button" class="bp-tab active" data-bp="0" role="tab" aria-selected="true">
        <span class="bp-idx">01</span>
        <span>Google Maps &amp; Town Expansion</span>
      </button>
      <button type="button" class="bp-tab" data-bp="1" role="tab" aria-selected="false">
        <span class="bp-idx">02</span>
        <span>Missed Calls &amp; Slow Quotes</span>
      </button>
      <button type="button" class="bp-tab" data-bp="2" role="tab" aria-selected="false">
        <span class="bp-idx">03</span>
        <span>Credit Cards &amp; Customer Financing</span>
      </button>
      <button type="button" class="bp-tab" data-bp="3" role="tab" aria-selected="false">
        <span class="bp-idx">04</span>
        <span>Late-Night Admin &amp; Paperwork</span>
      </button>
    </div>

    <div class="bp-stage">
      <!-- Left: The Old Way -->
      <div class="bp-card old">
        <div class="bp-badge warn mono"><i></i> THE OLD WAY // STUCK IN ONE TOWN</div>
        <h3 id="bp-old-title">Invisible on Google Maps &amp; missing nearby towns</h3>
        <ul class="bp-list" id="bp-old-list">
          <li>Competitors with worse work show up ahead of you in the Google Top 3 Map Pack</li>
          <li>You only get calls in your own zip code while missing high-paying neighboring towns</li>
          <li>Happy customers promise to leave a Google review, then forget as soon as you leave</li>
          <li>Paying Angi or HomeAdvisor $80+ for shared leads sold to 5 other contractors</li>
        </ul>
        <div class="bp-metric bad mono">
          <span>WHAT IT COSTS YOU</span>
          <b id="bp-old-stat">Locked out of nearby towns</b>
        </div>
      </div>

      <!-- Center: Live Animated SVG Circuit Pipeline -->
      <div class="bp-pipe" aria-hidden="true">
        <svg viewBox="0 0 260 320" fill="none" class="bp-svg">
          <defs>
            <linearGradient id="pipeGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.15"/>
              <stop offset="50%" stop-color="#fde68a" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.15"/>
            </linearGradient>
          </defs>
          <path d="M130 24 L130 296" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" stroke-dasharray="4 4"/>
          <path d="M130 24 C130 95, 45 95, 45 160 C45 225, 130 225, 130 296" stroke="url(#pipeGrad)" stroke-width="2"/>
          <path d="M130 24 C130 95, 215 95, 215 160 C215 225, 130 225, 130 296" stroke="url(#pipeGrad)" stroke-width="1.75" opacity="0.5"/>

          <circle r="4.5" fill="#fde68a">
            <animateMotion dur="2.5s" repeatCount="indefinite" path="M130 24 C130 95, 45 95, 45 160 C45 225, 130 225, 130 296"/>
          </circle>
          <circle r="3.5" fill="#ffffff">
            <animateMotion dur="2.5s" begin="1.25s" repeatCount="indefinite" path="M130 24 C130 95, 215 95, 215 160 C215 225, 130 225, 130 296"/>
          </circle>

          <g transform="translate(130, 32)">
            <rect x="-78" y="-16" width="156" height="32" rx="16" fill="#0d0e11" stroke="rgba(251,191,36,0.3)"/>
            <text id="bp-node-1" x="0" y="4" text-anchor="middle" fill="#e4e4e7" font-family="JetBrains Mono" font-size="10">01 // LOCAL SEARCH</text>
          </g>
          <g transform="translate(130, 160)">
            <rect x="-92" y="-18" width="184" height="36" rx="18" fill="#17140d" stroke="#fbbf24"/>
            <text id="bp-node-2" x="0" y="4" text-anchor="middle" fill="#fde68a" font-family="JetBrains Mono" font-size="10" font-weight="600">MAP PACK + TOWN SEO</text>
          </g>
          <g transform="translate(130, 288)">
            <rect x="-82" y="-16" width="164" height="32" rx="16" fill="#0d0e11" stroke="rgba(251,191,36,0.3)"/>
            <text id="bp-node-3" x="0" y="4" text-anchor="middle" fill="#fde68a" font-family="JetBrains Mono" font-size="10">03 // EXCLUSIVE CALLS</text>
          </g>
        </svg>
      </div>

      <!-- Right: Running on 1337 -->
      <div class="bp-card new">
        <div class="bp-badge ok mono"><i></i> WITH 1337 // MULTI-TOWN DOMINATION</div>
        <h3 id="bp-new-title">Rank in the Top 3 &amp; expand into neighboring towns</h3>
        <ul class="bp-list ok-list" id="bp-new-list">
          <li>Complete Google Business Profile overhaul engineered for the Top 3 Map Pack</li>
          <li>Dedicated Service + Town expansion pages so you rank in surrounding cities</li>
          <li>Automatic 1-tap text after every finished job turns happy clients into 5-star reviews</li>
          <li>100% exclusive phone calls and quote requests—$0 per-lead fees ever</li>
        </ul>
        <div class="bp-metric good mono">
          <span>THE PAYOFF</span>
          <b id="bp-new-stat">Take over 5–10 nearby towns · $0 lead fees</b>
        </div>
      </div>
    </div>
  </div>
</div></section>

<script>
const SCENARIOS = [
  {
    oldTitle: 'Invisible on Google Maps & missing nearby towns',
    oldList: [
      'Competitors with worse work show up ahead of you in the Google Top 3 Map Pack',
      'You only get calls in your own zip code while missing high-paying neighboring towns',
      'Happy customers promise to leave a Google review, then forget as soon as you leave',
      'Paying Angi or HomeAdvisor $80+ for shared leads sold to 5 other contractors',
    ],
    oldStat: 'Locked out of nearby towns',
    node1: '01 // LOCAL SEARCH',
    node2: 'MAP PACK + TOWN SEO',
    node3: '03 // EXCLUSIVE CALLS',
    newTitle: 'Rank in the Top 3 & expand into neighboring towns',
    newList: [
      'Complete Google Business Profile overhaul engineered for the Top 3 Map Pack',
      'Dedicated Service + Town expansion pages so you rank in surrounding cities',
      'Automatic 1-tap text after every finished job turns happy clients into 5-star reviews',
      '100% exclusive phone calls and quote requests—$0 per-lead fees ever',
    ],
    newStat: 'Take over 5–10 nearby towns · $0 lead fees',
  },
  {
    oldTitle: 'Voicemail is where customers disappear',
    oldList: [
      'Customer calls while you are on a loud job site or with a client',
      'Gets voicemail → hangs up and calls the next company on Google',
      'You call back at 6 PM, but they already hired someone else',
      'Driving across town just to quote people who only wanted a ballpark price',
    ],
    oldStat: '$3,600+ / mo in lost work',
    node1: '01 // MISSED CALL',
    node2: 'INSTANT TEXT-BACK',
    node3: '03 // JOB SAVED',
    newTitle: 'Every caller gets an instant text back',
    newList: [
      'Missed call triggers an immediate, friendly text in your voice right away',
      'Customer texts back their address & job photos while you finish working',
      'Website price calculator gives ballpark estimates so tire-kickers filter out',
      'The job details land on your phone ready to book—zero apps to learn',
    ],
    newStat: 'Zero lost calls · Hours saved every week',
  },
  {
    oldTitle: 'Waiting weeks for checks & losing big-ticket jobs',
    oldList: [
      'Finishing a job and saying "I will email you the bill tonight"',
      'Customer takes weeks to mail a check or forgets to pay',
      'Losing $3,000–$15,000 jobs because homeowners cannot pay the full cash upfront',
      'No easy way to take a credit card or Apple Pay in the driveway',
    ],
    oldStat: 'Weeks waiting on money',
    node1: '01 // JOB FINISHED',
    node2: 'CARD / FINANCING / TEXT',
    node3: '03 // PAID ON THE SPOT',
    newTitle: 'Take Credit Cards, Text-to-Pay & Customer Financing',
    newList: [
      'Send a quick text invoice from your phone before leaving the job',
      'Customer pays by Credit Card, Debit Card, Apple Pay, Google Pay or ACH',
      'Offer "Pay Over Time" financing on big jobs while you get paid upfront',
      'Optional Cash App, Strike or Lightning setup to skip 3% card swipe fees',
    ],
    newStat: 'Paid before you leave the driveway',
  },
  {
    oldTitle: 'Typing quotes at the kitchen table at 10 PM',
    oldList: [
      'Addresses and measurements written on receipts and sticky notes',
      'Spending Sunday night typing estimates and chasing people who ghosted',
      'Typing the same customer info into three different places',
      'Old past customers forgetting about you when the season changes',
    ],
    oldStat: '10+ hrs/wk lost at night',
    node1: '01 // OPEN ESTIMATE',
    node2: 'AUTO FOLLOW-UP',
    node3: '03 // QUOTE APPROVED',
    newTitle: 'Quotes that follow up on themselves',
    newList: [
      'Speak into your phone in the truck to draft a clean estimate right away',
      'Open quotes automatically text a friendly check-in until they book',
      'Seasonal text blasts wake up your past customers when your schedule is slow',
      'Simple one-page tracker shows every lead, job, expense and real profit',
    ],
    newStat: 'Your evenings & weekends back',
  },
];

const tabs = document.querySelectorAll<HTMLButtonElement>('.bp-tab');
const oldTitle = document.getElementById('bp-old-title');
const oldList = document.getElementById('bp-old-list');
const oldStat = document.getElementById('bp-old-stat');
const newTitle = document.getElementById('bp-new-title');
const newList = document.getElementById('bp-new-list');
const newStat = document.getElementById('bp-new-stat');
const n1 = document.getElementById('bp-node-1');
const n2 = document.getElementById('bp-node-2');
const n3 = document.getElementById('bp-node-3');
const stage = document.querySelector<HTMLElement>('.bp-stage');

tabs.forEach((btn) => {
  btn.addEventListener('click', () => {
    const idx = +(btn.dataset.bp || 0);
    const s = SCENARIOS[idx];
    if (!s) return;

    tabs.forEach((t) => {
      t.classList.toggle('active', t === btn);
      t.setAttribute('aria-selected', String(t === btn));
    });

    if (stage) {
      stage.classList.add('switching');
      setTimeout(() => stage.classList.remove('switching'), 180);
    }

    if (oldTitle) oldTitle.textContent = s.oldTitle;
    if (oldList) oldList.innerHTML = s.oldList.map((i) => `<li>${i}</li>`).join('');
    if (oldStat) oldStat.textContent = s.oldStat;
    if (newTitle) newTitle.textContent = s.newTitle;
    if (newList) newList.innerHTML = s.newList.map((i) => `<li>${i}</li>`).join('');
    if (newStat) newStat.textContent = s.newStat;
    if (n1) n1.textContent = s.node1;
    if (n2) n2.textContent = s.node2;
    if (n3) n3.textContent = s.node3;
  });
});
</script>
