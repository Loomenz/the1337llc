---
// Home page: the four problems we fix, in the owner's words, each with a starting price.
const fixes = [
  {
    pain: 'Missing calls while you work',
    fix: 'Every missed call gets an instant text back, so the customer waits for you instead of calling the next company on Google.',
    price: 'from $249',
    icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  },
  {
    pain: 'Quotes that take days',
    fix: 'A price calculator on your site and quotes you send from your phone, with automatic follow-ups so no quote goes cold.',
    price: 'from $299',
    icon: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 6h6M9 10h.01M12 10h.01M15 10h.01M9 14h.01M12 14h.01M15 14h.01M9 18h6"/>',
  },
  {
    pain: 'Chasing people to get paid',
    fix: 'Card, tap and text-to-pay invoices, so you get paid on site instead of waiting on checks.',
    price: 'from $249',
    icon: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>',
  },
  {
    pain: 'Hard to find on Google',
    fix: 'A fast website, a cleaned-up Google Business Profile and a simple way to collect reviews after every job.',
    price: 'sites from $1,200',
    icon: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  },
];
---
<section id="fixes"><div class="wrap">
  <div class="head reveal"><div><div class="eyebrow">What we fix</div><h2>The problems that<br>cost you <span class="grad serif">real money.</span></h2></div>
  <p class="sub">Most owners lose jobs to the same few problems. We start with the one costing you the most, fix it in days, and work up from there.</p></div>
  <div class="bento">
    {fixes.map((f) => (
      <div class="tile w3 reveal">
        <div class="ic"><svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={f.icon} /></div>
        <h3>{f.pain}</h3>
        <p>{f.fix}</p>
        <p class="fix-price mono">{f.price}</p>
      </div>
    ))}
  </div>
  <div class="more-link reveal"><a class="btn magnetic" href="/services/">Everything we build <span class="arr">→</span></a></div>
</div></section>

<style>
.fix-price{margin-top:18px;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink)}
</style>
