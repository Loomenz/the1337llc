---
// Top of every inner page: mono label, big headline with one serif accent word, short lead.
// Pass a <Panel slot="aside"> to fill the right side with a product-style card.
interface Props {
  label: string;
  title: string;
  accent: string; // shown in the white-to-grey serif style on its own line
  lead: string;
}
const { label, title, accent, lead } = Astro.props;
const aside = Astro.slots.has('aside');
---
<section class="page-hero"><div class={aside ? 'wrap page-hero-grid' : 'wrap'}>
  <div>
    <div class="label mono"><span class="dot"><i></i></span>{label}</div>
    <h1>
      <span class="line"><span>{title}</span></span>
      <span class="line"><span class="grad serif">{accent}</span></span>
    </h1>
    <p class="lead">{lead}</p>
    <slot />
  </div>
  {aside && <div class="page-hero-aside"><slot name="aside" /></div>}
</div></section>
