---
// Click-to-open questions with FAQ schema for Google.
interface Props {
  items: [string, string][];
}
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section style="padding-top:0"><div class="wrap faq-wrap">
  <div class="reveal"><div class="eyebrow">Questions</div><h2>Before you <span class="grad">ask.</span></h2>
    <p class="sub">Still wondering about something? Email <a class="ul" href="mailto:ryan@the1337llc.com">ryan@the1337llc.com</a> and you'll hear back within one business day.</p></div>
  <div class="faq">
    {items.map(([q, a], i) => (
      <details class="reveal" open={i === 0}><summary>{q}<span class="pm" aria-hidden="true"></span></summary><p>{a}</p></details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</div></section>
