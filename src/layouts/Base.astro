---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportChat from '../components/SupportChat.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
}

const {
  title = '1337 | Local Help for NWI Businesses: Calls, Google & Payments',
  description = '1337 LLC helps Northwest Indiana businesses stop losing jobs: missed-call text-backs, Google profile fixes, quote follow-up, on-site payments and websites, at flat prices.',
  ogTitle = title,
  ogDescription = description,
  image = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<meta name="theme-color" content="#070707">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<slot name="head" />
<script is:inline>
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (!location.hash) addEventListener('load', () => scrollTo({ top: 0, behavior: 'instant' }));
</script>
</head>
<body>
<div class="bg"><div class="blob b1"></div></div>
<div class="noise"></div><div class="cursor" id="glow"></div>

<Header />

<main id="top">
<slot />
</main>

<Footer />
<SupportChat />

<script>
import { scramble } from '../scripts/scramble';
import { initMotion } from '../scripts/motion';

initMotion();

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const fine = matchMedia('(pointer: fine)').matches;
document.getElementById('yr')!.textContent = String(new Date().getFullYear());

// nav state
const nav = document.getElementById('nav')!;
addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 30), { passive: true });

// subtle ambient cursor glow
const glow = document.getElementById('glow')!;
if (fine && !reduce) {
  addEventListener('pointermove', (e) => {
    glow.style.left = e.clientX + 'px';
    glow.style.top = e.clientY + 'px';
  }, { passive: true });
} else {
  glow.style.display = 'none';
}

// scramble on hover
document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
  const t = el.textContent || '';
  el.addEventListener('mouseenter', () => scramble(el, t, 600));
});

// reveal on scroll
const io = new IntersectionObserver((es) => es.forEach((e) => {
  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}), { threshold: .1, rootMargin: '0px 0px -30px 0px' });
document.querySelectorAll<HTMLElement>('.reveal').forEach((el, i) => { el.style.transitionDelay = (i % 3) * 60 + 'ms'; io.observe(el); });

// subtle card glare + micro-tilt
const depth = '.tilt, .bento > .tile, .price, .post-card, .stat';
if (fine && !reduce) document.querySelectorAll<HTMLElement>(depth).forEach((c) => {
  const k = c.classList.contains('tilt') ? 3.5 : 4.5;
  c.classList.add('depth-tilt');
  c.addEventListener('pointermove', (e) => {
    const r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
    c.classList.add('tilting');
    c.style.transform = `perspective(1200px) rotateY(${x * k}deg) rotateX(${-y * k}deg) translateY(-4px)`;
    c.style.setProperty('--x', e.clientX - r.left + 'px');
    c.style.setProperty('--y', e.clientY - r.top + 'px');
  });
  c.addEventListener('pointerleave', () => { c.classList.remove('tilting'); c.style.transform = ''; });
});

// magnetic buttons
if (fine && !reduce) document.querySelectorAll<HTMLElement>('.magnetic').forEach((b) => {
  b.addEventListener('pointermove', (e) => {
    const r = b.getBoundingClientRect();
    b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .15}px,${(e.clientY - r.top - r.height / 2) * .22}px)`;
  });
  b.addEventListener('pointerleave', () => b.style.transform = '');
});
</script>
</body>
</html>
