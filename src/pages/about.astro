---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import Mascot from '../components/site/Mascot.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { TOWNS } from '../data/business';

const rules: [string, string][] = [
  ['We pick up when you call.', 'Or we text you back the same day. Being hard to reach is the thing we fix for you, so we are not going to do it to you.'],
  ['You own your site.', 'Domain, code, photos, accounts. All yours, even if you stop paying us. No hostage situations.'],
  ['Plain English.', "If we use a word you don't know, that's on us. You will never need to learn our software to get your stuff."],
  ['The price is the price.', 'A fixed quote in writing before any work starts. It does not creep after you say yes.'],
  ['No #1-on-Google promises.', 'Anybody promising that is lying. We show you what moved every month: calls, map views, rankings.'],
  ['Anyone, not just contractors.', 'Trades are our bread and butter, but shops, salons, offices and startups get the same crew. If you can describe it, we can quote it.'],
];
---
<Site title="About 1337: Local Web Studio in Northwest Indiana & Chicagoland" description="1337 is a local crew in Northwest Indiana and Chicagoland that builds websites, gets small businesses found on Google and sets up tools that answer the phone. Flat prices, plain English, and you own everything.">
  <PageHead num="About" label="Who you'd be working with" lines={['Local crew.', 'Real <span class="accent">tools.</span>']} lede="We own and run other businesses too, a construction company among them, so we know the long days, missed calls and late-night paperwork firsthand. 1337 is our web studio in Northwest Indiana. We build for owners who would rather be doing the work than fighting a laptop." />

  <section class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] pb-20 md:px-8" aria-labelledby="rules-title">
    <div class="mb-8 flex items-end justify-between gap-4 border-b-2 border-ink pb-4">
      <h2 id="rules-title" class="mono text-[.75rem] uppercase tracking-[.12em]">House rules</h2>
      <span class="mono text-[.75rem] uppercase tracking-[.12em] text-mute">Posted on the shop wall</span>
    </div>
    <ol class="grid gap-x-12 md:grid-cols-2">
      {rules.map(([h, p], i) => (
        <li class="rule">
          <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="display text-[clamp(2.2rem,4.4vw,3.8rem)]">{h}</h3>
            <p class="mt-3 max-w-[46ch] text-[1.1rem] leading-relaxed text-mute">{p}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-ink text-paper" aria-labelledby="bot-title">
    <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24 lg:grid-cols-12">
      <div class="bot-stage lg:col-span-5" style="font-size:clamp(9rem,26vw,20rem)">
        <Mascot />
        <span aria-hidden="true" class="barricade"></span>
      </div>
      <div class="lg:col-span-7">
        <p class="mono text-[.75rem] uppercase tracking-[.12em] text-mute-dark">Crew member · Unit 1337</p>
        <h2 id="bot-title" class="display mt-4 text-[clamp(2.8rem,7vw,6.4rem)]">The only one who skips <span class="accent text-hivis">coffee.</span></h2>
        <p class="mt-6 max-w-[48ch] text-[1.2rem] leading-relaxed text-paper/80">Unit 1337 is the crew bot. He stands for the tools we build: the ones that answer the phone, text people back and keep the calendar full while you work. Hover him. Tap him. And if you type 1337 anywhere on this site, something happens.</p>
        <p class="mt-4 max-w-[48ch] text-[1.2rem] leading-relaxed text-paper/80">And the name? 1337 is old internet slang for "elite." It's a high bar. We try to earn it on every job.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24" aria-labelledby="area-title">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="mono mb-4 text-[.75rem] uppercase tracking-[.12em] text-mute">Service area</p>
        <h2 id="area-title" class="display mask-lines text-[clamp(2.8rem,6vw,5.4rem)]"><span class="ml"><span>Where we</span></span><span class="ml"><span><span class="sweep on-scroll">work.</span></span></span></h2>
        <p class="mt-6 max-w-[34ch] text-[1.1rem] leading-relaxed text-mute">Northwest Indiana and Chicagoland in person. Anywhere else by phone and screen share. We don't have a storefront; we come to you.</p>
      </div>
      <ul class="towns lg:col-span-8">
        {TOWNS.map((t) => <li class="display">{t}</li>)}
      </ul>
    </div>
  </section>
  <CtaBand />
</Site>

<style>
  .rule { display: grid; grid-template-columns: 2.6rem 1fr; gap: .5rem; padding: 1.8rem 0; border-bottom: 1px solid rgb(17 17 17 / .22); }
  .rule .n { font-size: .8rem; padding-top: .5rem; color: var(--color-hivis); font-weight: 700; }
  .bot-stage { position: relative; display: grid; place-items: center; line-height: .84; padding-bottom: .12em; }
  .bot-stage :global(.unit) { cursor: pointer; }
  .barricade { position: absolute; left: 4%; right: 4%; bottom: 0; height: .2em; border-radius: 6px; background: repeating-linear-gradient(-45deg, var(--color-hivis) 0 .12em, var(--color-paper) .12em .24em); }
  .towns { display: flex; flex-wrap: wrap; gap: .1em .5em; font-size: clamp(1.8rem, 4vw, 3.4rem); line-height: 1; align-content: start; }
  .towns li { display: inline-flex; align-items: center; gap: .5em; }
  .towns li:not(:last-child)::after { content: ""; width: .22em; height: .22em; background: var(--color-hivis); transform: rotate(45deg); }
</style>
