---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import Panel from '../components/Panel.astro';


const values: [string, string][] = [
  ['Flat, up-front pricing', 'A fixed quote in writing before anything starts. No hourly meter running in the background.'],
  ['You own everything', 'Your domain, your code, your data and your accounts. No lock-in, even if you stop a plan.'],
  ['Outcomes over buzzwords', 'We do not sell trendy tech for the sake of tech. Every system we build either brings in more jobs or eliminates manual hours.'],
  ['We keep it running', 'Hosting on our own server infrastructure, backups before every release and someone local to call when something breaks.'],
];
---
<Base
  title="About 1337 LLC: Business Engineering & Software Studio | 1337"
  description="1337 LLC is a Northwest Indiana software and business engineering studio that builds websites, lead-recovery systems and custom tools that pay for themselves."
>
  <PageHero
    label="About // Northwest Indiana + remote"
    title="Built by someone"
    accent="who's been there."
    lead="Before 1337 LLC, our founder spent years working in construction. We know how little time owners have for complicated software, so we build turn-key systems that run quietly and pay for themselves."
  >
    <Panel slot="aside" file="whoami" status="online" rows={[
      ['company', '1337 LLC'],
      ['based in', 'Northwest Indiana'],
      ['works with', 'anyone, anywhere'],
      ['builds', 'sites, lead systems, software'],
      ['pricing', 'flat, in writing'],
      ['lock-in', 'none'],
    ]} foot={['reply time', '1 business day']} />
  </PageHero>
  <section style="padding-top:0"><div class="wrap">
    <div class="head reveal"><div><div class="eyebrow">What we believe</div><h2>Tech should <span class="grad">earn its keep.</span></h2></div>
    <p class="sub">We build for contractors, shops, service businesses and operators anywhere. If a problem is costing you time or jobs, we can engineer the fix for a flat price.</p></div>
    <div class="grid4">{values.map(([t, d], i) => (
      <div class="post-card reveal"><span class="mono">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
    ))}</div>
  </div></section>
  <Stats />
  <CtaBand title="Let's talk about your business." />
</Base>
