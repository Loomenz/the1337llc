---
import Base from '../layouts/Base.astro';
---
<Base title="Free Google & Website Check for Local Businesses | 1337 LLC" description="Find out what's costing your business calls. We search for you the way a customer would and send the 3 biggest fixes. Free for Northwest Indiana and Chicagoland businesses.">
  <section class="post-list"><div class="wrap"><div class="contact reveal">
    <div><div class="eyebrow">Free check</div><h2>What's costing you <span class="grad">calls?</span></h2>
      <p class="sub">We search for your business the way a customer in your area would, check your Google listing and your website on a phone, then send you one page with the 3 biggest fixes.</p>
      <ul class="checks"><li>Where you show up on Google and the map</li><li>How you compare to the top competitor near you</li><li>Your reviews, photos and profile details</li><li>Your website's speed and mobile experience</li><li>Free. No sales pitch unless you ask for one.</li></ul></div>
    <form action="https://formsubmit.co/the1337llc@gmail.com" method="POST">
      <input type="hidden" name="_subject" value="Free Google check request"><input type="hidden" name="_template" value="table">
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
      <div class="row"><div class="f"><input id="n" name="name" placeholder=" " required><label for="n">Your name</label></div>
        <div class="f"><input id="b" name="business" placeholder=" " required><label for="b">Business name</label></div></div>
      <div class="row"><div class="f"><input id="e" type="email" name="email" placeholder=" " required><label for="e">Email</label></div>
        <div class="f"><input id="p" type="tel" name="phone" placeholder=" "><label for="p">Phone (optional)</label></div></div>
      <div class="row"><div class="f"><input id="t" name="trade" placeholder=" " required><label for="t">What you do (e.g. roofing)</label></div>
        <div class="f"><input id="c" name="town" placeholder=" " required><label for="c">Main town you serve</label></div></div>
      <div class="f"><input id="w" name="website" placeholder=" "><label for="w">Website (if you have one)</label></div>
      <button class="btn primary magnetic" type="submit" style="justify-self:start">Send my free check <span class="arr">→</span></button>
    </form>
  </div></div></section>
</Base>
