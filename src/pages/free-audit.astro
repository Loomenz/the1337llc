---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import { BUSINESS, FORM } from '../data/business';
const checks = ['Where you show up on Google and the map', 'How you stack up against the top shop near you', 'Your reviews, photos and profile details', "Your website's speed on a phone", 'Free. No sales pitch unless you ask for one.', 'We text you when it is ready. Add an email if you want it there too.'];
---
<Site title="Free Google & Website Check for Local Businesses | 1337" description="Find out what's costing your business calls. We search for you the way a customer would and send the 3 biggest fixes. Free for Northwest Indiana and Chicagoland businesses.">
  <PageHead num="Free check" label="No catch" lines={["What's costing", 'you <span class="sweep on-load">calls?</span>']} lede="We search for your business the way a customer near you would, check your Google listing and your site on a phone, then send you one page with the 3 biggest fixes." />
  <section class="mx-auto grid max-w-[1440px] gap-12 px-[max(16px,env(safe-area-inset-left,0px))] pb-20 md:px-8 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="mono mb-4 text-[.75rem] uppercase tracking-[.12em] text-mute">What we check</p>
      <ul class="prose-site">{checks.map((c) => <li>{c}</li>)}</ul>
    </div>
    <form id="form" class="form lg:col-span-7 scroll-mt-24" action={FORM.action} method="POST" data-audit>
      <header class="mono flex items-center justify-between border-b-2 border-ink pb-3 text-[.75rem] uppercase tracking-[.1em]"><span>Free check request</span><span>Back in 2 business days</span></header>
      <input type="hidden" name="access_key" value={FORM.accessKey}>
      <input type="hidden" name="subject" value="Free Google check request">
      <input type="hidden" name="from_name" value="1337 website">
      <p class="thanks" role="status" hidden data-thanks>Got it. Your free check will be with you within 2 business days.</p>
      <input type="hidden" name="redirect" value={`${BUSINESS.url}/free-audit/?sent=1#form`}>
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="f"><span>Your name</span><input name="name" autocomplete="name" required></label>
        <label class="f"><span>Business name</span><input name="business" autocomplete="organization" required></label>
        <label class="f"><span>Phone (we'll text)</span><input name="phone" type="tel" autocomplete="tel" inputmode="tel" required></label>
        <label class="f"><span>Email <i>(optional)</i></span><input name="email" type="email" autocomplete="email"></label>
        <label class="f"><span>What you do</span><input name="trade" placeholder="e.g. hair salon, roofing" required></label>
        <label class="f"><span>Main town you serve</span><input name="town" placeholder="e.g. Crown Point" required></label>
      </div>
      <label class="f"><span>Website <i>(if you have one)</i></span><input name="website" inputmode="url"></label>
      <button type="submit" class="justify-self-start inline-flex items-center gap-2 rounded-full bg-ink px-7 py-4 text-[1.08rem] font-semibold text-paper transition-colors hover:bg-hivis hover:text-ink">Send my free check <span aria-hidden="true">→</span></button>
    </form>
  </section>
</Site>

<style>
  .form { display: grid; gap: 1.3rem; align-self: start; padding: 1.4rem; border: 2px solid var(--color-ink); border-radius: 14px; background: var(--color-paper); box-shadow: 10px 10px 0 var(--color-hivis); }
  @media (min-width: 768px) { .form { padding: 2rem 2.2rem 2.2rem; } }
  .f { display: grid; gap: .45rem; }
  .f > span { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; }
  .f i { font-style: normal; color: var(--color-mute); }
  .f input { width: 100%; min-height: 52px; padding: .8rem .95rem; font: inherit; font-size: 1.08rem; border: 2px solid var(--color-ink); border-radius: 8px; background: #fff; }
  .f input:focus-visible { outline: 3px solid var(--color-hivis); outline-offset: 1px; }
  .thanks { background: var(--color-hivis); padding: 1rem 1.1rem; border-radius: 8px; font-weight: 600; }
</style>

<script>
  // After sending, Web3Forms returns here with ?sent=1 and we show the thank-you in place.
  function initAudit() {
    const form = document.querySelector<HTMLFormElement>('[data-audit]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    if (new URLSearchParams(location.search).get('sent')) form.querySelector<HTMLElement>('[data-thanks]')!.hidden = false;
  }
  initAudit();
  document.addEventListener('astro:page-load', initAudit);
</script>
