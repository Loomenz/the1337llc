---
import Site from '../layouts/Site.astro';
import PageHead from '../components/site/PageHead.astro';
import Faq from '../components/site/Faq.astro';
import CtaBand from '../components/site/CtaBand.astro';

// What we've built and keep running. Client projects stay unnamed on purpose.
const systems: [string, string, boolean][] = [
  ['Owner dashboards', 'Calls, leads, bookings and money on one screen, instead of five apps and a notebook. From $2,500.', false],
  ['Quote + invoice tools', 'Built around how you actually price and bill, so a quote takes two minutes, not twenty. From $1,500.', false],
  ['Online stores', 'Products, sizes and stock, order and tracking emails, refunds, and an admin screen that runs the shop.', true],
  ['Payments built in', 'Checkout that fits how your customers pay: cards, Cash App and more. Stock is held while the buyer pays, and you get paid fast.', true],
  ['Marketplaces + portals', 'Accounts for buyers and sellers, listings, custom orders, reviews, messaging and a full admin panel.', true],
  ['Chat assistants', 'Chat that knows your business and answers customers 24/7. Tested before every update so it does not make things up.', true],
  ['Lead lists', 'Finds likely customers from public sources, scores each one and drafts the first message, straight into a spreadsheet.', false],
  ['Hosting we run ourselves', 'Your own server, not a rented template. A backup before every update and an automatic roll-back if anything fails.', true],
];
const steps: [string, string][] = [
  ['Talk it through', 'A call about what it needs to do, who uses it and how you get paid. No tech talk needed.'],
  ['Fixed quote + plan', 'A written scope, a fixed price and a timeline before any work starts.'],
  ['Build + test', 'Built in stages you can click through. Every flow, payment and email tested before launch.'],
  ['Launch + run it', 'We host it, back it up, watch it and keep improving it. You own the code and the data.'],
];
const faq: [string, string][] = [
  ['What kinds of systems do you build?', 'Dashboards, quote and invoice tools, online stores, booking tools, customer portals, checkout and payment systems, chat assistants and glue between the tools you already pay for. If you can describe it, we can quote it.'],
  ['Do you only work with local businesses?', 'No. We are based in Northwest Indiana and work with businesses anywhere, in person or remote.'],
  ['How much does a custom system cost?', 'It depends on what it needs to do. Every project gets a fixed quote after a call, so you know the full price before we start.'],
  ['Who owns it when it is done?', 'You do. The code, the data and the accounts are yours. We can keep running it on a monthly plan, or hand it off.'],
];
---
<Site title="Custom Software, Dashboards & Online Stores for Small Businesses | 1337" description="Owner dashboards, quote and invoice tools, online stores, payments and chat assistants, built and run by 1337 in Northwest Indiana for businesses anywhere. Fixed quotes.">
  <PageHead num="Custom builds" label="When nobody sells what you need" lines={['Not just', '<span class="accent">websites.</span>']} lede="Dashboards, stores, booking and payment tools we designed, built and keep running every day. If you can describe it, we can build it." />

  <section class="bg-ink text-paper">
    <ol class="mx-auto grid max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-12 md:grid-cols-2 md:px-8 md:py-20">
      {systems.map(([h, p, live], i) => (
        <li class="sys">
          <div class="flex items-center justify-between gap-4">
            <span class="mono text-[.75rem] text-mute-dark">{String(i + 1).padStart(2, '0')}</span>
            {live && <span class="mono live">● Running right now</span>}
          </div>
          <h2 class="display mt-4 text-[clamp(2.4rem,4.6vw,4rem)]">{h}</h2>
          <p class="mt-3 max-w-[48ch] text-[1.08rem] leading-relaxed text-paper/75">{p}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-[1440px] px-[max(16px,env(safe-area-inset-left,0px))] py-16 md:px-8 md:py-24">
    <h2 class="display mask-lines text-[clamp(2.8rem,7vw,6.4rem)]"><span class="ml"><span>Idea to <span class="accent">running.</span></span></span></h2>
    <ol class="mt-10 grid border-t-2 border-ink md:grid-cols-4">
      {steps.map(([h, p], i) => (
        <li class="border-b border-ink/25 py-6 md:border-b-0 md:border-r md:px-5 md:first:pl-0 md:last:border-r-0">
          <span class="mono text-[.8rem] font-bold text-hivis">{String(i + 1).padStart(2, '0')}</span>
          <b class="mt-2 block text-[1.3rem]">{h}</b>
          <p class="mt-2 text-mute">{p}</p>
        </li>
      ))}
    </ol>
  </section>
  <Faq items={faq} num="Systems · FAQ" />
  <CtaBand title="Got something bigger in mind?" accent="Describe it. Get a fixed quote." />
</Site>

<style>
  .sys { padding: 2rem 0; border-top: 1px solid rgb(242 240 234 / .22); }
  @media (min-width: 768px) { .sys { padding: 2.4rem 2.4rem 2.4rem 0; } .sys:nth-child(even) { padding-left: 2.4rem; border-left: 1px solid rgb(242 240 234 / .22); } }
  .live { font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-hivis); }
  @media (prefers-reduced-motion: no-preference) { .live { animation: blinklive 2s steps(2) infinite; } @keyframes blinklive { 50% { opacity: .45; } } }
</style>
