---
import Base from '../layouts/Base.astro';
import Systems from '../components/Systems.astro';
import Contact from '../components/Contact.astro';
import Faq from '../components/Faq.astro';

const steps: [string, string][] = [
  ['Tell us what is slowing you down', 'A free 20-minute call about how you get customers, how you bill them, and what paperwork is eating up your week. Zero tech jargon.'],
  ['Flat written quote', 'You get a simple written plan, a fixed flat price and a launch date before any work starts.'],
  ['We build & test it', 'We set everything up and let you try it right on your phone—testing every credit card payment, text message and form before launch.'],
  ['We keep it running', 'We host it, back it up every night and handle any changes you need. You own 100% of your site, code and customer list.'],
];

const faq: [string, string][] = [
  ['What kinds of tools do you set up?', 'Credit card and Text-to-Pay phone invoicing, customer financing ("Pay Over Time"), online ballpark price calculators, instant missed-call text-back, automatic quote follow-ups, past-customer text blasts, online stores, booking portals, and simple one-page job trackers.'],
  ['Can you set up normal credit cards, Apple Pay and customer financing?', 'Yes! We set up everyday credit cards, debit cards, Apple Pay, Google Pay, ACH bank transfers, and customer financing ("Pay Over Time" monthly payment plans for big jobs) first so your customers can pay on the spot. We can also add Cash App, Strike or Bitcoin Lightning if you want to skip 3% card swipe fees.'],
  ['How do payments and financing work for a custom setup?', 'Projects start with a 50% deposit (with the other 50% due at launch), or you can finance the build monthly at checkout through third-party lenders like Klarna or Affirm so we can start right away.'],
  ['Do you only work with local businesses?', 'We are based in Northwest Indiana and work with contractors, shops and businesses across NWI, Chicagoland and anywhere in the country.'],
  ['How much does a custom setup cost?', 'Every project gets a flat, fixed price in writing after a short call, so you know the exact cost and deposit before saying yes.'],
  ['Who owns it when it is done?', 'You do. Once your build is paid in full, your domain, customer list, accounts and code belong 100% to you—zero lock-in.'],
];

---
<Base
  title="Credit Card Invoicing, Quote Calculators & Custom Business Tools | 1337"
  description="Take credit cards and Text-to-Pay in the driveway, catch missed calls automatically, and run your business without late-night paperwork. Built by 1337 LLC."
>
  <Systems />
  <section style="padding-top:0"><div class="wrap">
    <div class="head reveal"><div><div class="eyebrow">How it works</div><h2>From headache to <span class="grad">handled.</span></h2></div></div>
    <div class="posts">{steps.map(([t, d], i) => (
      <div class="post-card reveal"><span class="mono">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
    ))}</div>
  </div></section>
  <Faq items={faq} />
  <Contact />
</Base>
