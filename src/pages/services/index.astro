---
import Base from '../../layouts/Base.astro';
import AuditCta from '../../components/AuditCta.astro';
import { services } from '../../data/services';
import { trades } from '../../data/trades';
---
<Base title="Solutions & Services | 1337" description="High-converting websites, 24/7 missed-call recovery, local SEO, back-office automation, field invoicing and IT for Northwest Indiana and Chicagoland businesses.">
  <section class="post-list"><div class="wrap">
    <div class="eyebrow">Solutions</div>
    <h2>Systems that bring in calls and <span class="grad">buy back your time.</span></h2>
    <div class="posts">{services.map((s) => (
      <a class="post-card" href={`/services/${s.slug}/`}>
        <span class="mono">{s.name}</span>
        <h3>{s.headline}</h3>
        <p>{s.description}</p>
      </a>
    ))}
      <a class="post-card" href="/systems/">
        <span class="mono">Custom Business Tools</span>
        <h3>Credit cards, customer financing &amp; custom tools</h3>
        <p>Take credit cards, Apple Pay, Text-to-Pay and customer financing on the spot—plus online stores, booking portals and custom business software.</p>
      </a>
    </div>
    <h2 style="margin-top:80px">Engineered for <span class="grad">your trade.</span></h2>
    <div class="posts">{trades.map((t) => (
      <a class="post-card" href={`/websites-for/${t.slug}/`}>
        <span class="mono">Solutions for</span>
        <h3>{t.trade}</h3>
        <p>{t.description}</p>
      </a>
    ))}</div>
    <AuditCta />
  </div></section>
</Base>
