---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Work from '../components/Work.astro';
import Services from '../components/Services.astro';
import Systems from '../components/Systems.astro';
import Stats from '../components/Stats.astro';
import Process from '../components/Process.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '1337 LLC',
  url: 'https://the1337llc.com/',
  email: 'ryan@the1337llc.com',
  image: 'https://the1337llc.com/work/spk-lawn.jpg',
  description: 'Websites, local SEO, AI integrations, custom software systems and small business development.',
  areaServed: [{ '@type': 'Place', name: 'Northwest Indiana' }, { '@type': 'Place', name: 'Chicagoland' }],
  address: { '@type': 'PostalAddress', addressRegion: 'IN', addressCountry: 'US' },
};
---
<Base
  ogTitle="1337 LLC | Tech that pays for itself"
  ogDescription="Websites, SEO, AI integrations and small business development for Northwest Indiana and Chicagoland businesses."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero />
  <Marquee />
  <Work />
  <Services />
  <Systems more />
  <Stats />
  <Process />
  <Pricing />
  <Contact />
</Base>
