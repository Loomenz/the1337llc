---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Blueprint from '../components/Blueprint.astro';
import Work from '../components/Work.astro';
import Walkthrough from '../components/Walkthrough.astro';
import Stats from '../components/Stats.astro';
import Pricing from '../components/Pricing.astro';
import CtaBand from '../components/CtaBand.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '1337 LLC',
  url: 'https://the1337llc.com/',
  email: 'ryan@the1337llc.com',
  image: 'https://the1337llc.com/work/spk-lawn.jpg',
  description: 'Local help for Northwest Indiana businesses: missed-call text-backs, Google profile fixes, quote follow-up, on-site payments and websites, at flat prices.',
  areaServed: [{ '@type': 'Place', name: 'Northwest Indiana' }, { '@type': 'Place', name: 'Chicagoland' }],
  address: { '@type': 'PostalAddress', addressRegion: 'IN', addressCountry: 'US' },
};
---
<Base
  ogTitle="1337 | Win More Jobs, Get Paid Faster & Kill Paperwork"
  ogDescription="Instant missed-call text-backs, online ballpark price calculators, credit card and customer-financing phone invoices, and local SEO for Northwest Indiana and Chicagoland businesses."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Hero />
  <Marquee />
  <Blueprint />
  <Work limit={4} />
  <Walkthrough />
  <Stats />
  <Pricing teaser />
  <CtaBand title="Tell us what's costing you jobs." />
</Base>
