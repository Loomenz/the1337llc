---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="How It Works: From First Call to Launch | 1337"
  description="How 1337 LLC builds your website or system: a free call, a fixed written quote, a live preview, launch and handoff, then optional ongoing growth."
>
  <PageHero
    label="Process // Five steps, no surprises"
    title="How we work,"
    accent="step by step."
    lead="No 40-page proposals and no six-month timelines. You always know what is being built, what it costs and when it goes live."
  />
  <Process />
  <CtaBand title="Start with a free call." text="Twenty minutes, no pressure. We find the smallest fix with the biggest payoff for your business." />
</Base>
