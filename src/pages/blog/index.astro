---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog | 1337 LLC" description="Tips on websites, Google and tech for Northwest Indiana and Chicagoland small businesses.">
  {posts.length === 0 && <meta slot="head" name="robots" content="noindex">}
  <section class="post-list"><div class="wrap">
    <div class="eyebrow">Blog</div>
    <h2>Notes for <span class="grad">local business owners.</span></h2>
    {posts.length === 0
      ? <p class="sub">First posts are on the way.</p>
      : <div class="posts">{posts.map((p) => (
          <a class="post-card" href={`/blog/${p.id}/`}>
            <span class="mono">{fmt(p.data.date)}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}</div>}
  </div></section>
</Base>
